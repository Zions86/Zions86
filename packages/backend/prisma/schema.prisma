generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  name          String?
  image         String?
  role          UserRole  @default(USER)
  provider      String?
  hashedPassword String?
  stories       Story[]   @relation("AuthorStories")
  aiChats       AIChat[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

enum UserRole {
  USER
  ADMIN
}

model Story {
  id          String      @id @default(uuid())
  author      User        @relation("AuthorStories", fields: [authorId], references: [id])
  authorId    String
  title       String
  genre       String?
  theme       String?
  audience    String?
  description String?
  summary     String?
  status      StoryStatus @default(DRAFT)
  characters  Character[]
  scenes      Scene[]
  worlds      World[]
  images      Image[]
  aiChats     AIChat[]
  cast        CastAssignment[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

enum StoryStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Character {
  id             String    @id @default(uuid())
  story          Story     @relation(fields: [storyId], references: [id])
  storyId        String
  name           String
  age            Int?
  gender         String?
  personality    String?
  background     String?
  appearance     String?
  occupation     String?
  goals          Json?
  relationships  Json?
  traits         Json?
  referenceImage Image?    @relation(fields: [referenceImageId], references: [id])
  referenceImageId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model World {
  id         String   @id @default(uuid())
  story      Story    @relation(fields: [storyId], references: [id])
  storyId    String
  title      String?
  era        String?
  environment String?
  weather    String?
  culture    String?
  timeline   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Scene {
  id         String     @id @default(uuid())
  story      Story      @relation(fields: [storyId], references: [id])
  storyId    String
  sceneNumber Int
  heading    String?
  location   String?
  slug       String     @unique
  content    Json
  order      Int
  dialogues  Dialogue[]
  images     Image[]
  versions   VersionHistory[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model Dialogue {
  id          String    @id @default(uuid())
  scene       Scene     @relation(fields: [sceneId], references: [id])
  sceneId     String
  character   Character? @relation(fields: [characterId], references: [id])
  characterId String?
  speakerName String?
  lineText    String
  meta        Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Image {
  id        String   @id @default(uuid())
  story     Story?   @relation(fields: [storyId], references: [id])
  storyId   String?
  scene     Scene?   @relation(fields: [sceneId], references: [id])
  sceneId   String?
  url       String
  provider  String
  prompt    String?
  width     Int?
  height    Int?
  metadata  Json?
  createdBy User?    @relation(fields: [createdById], references: [id])
  createdById String?
  createdAt DateTime @default(now())
}

model AIChat {
  id             String   @id @default(uuid())
  story          Story?   @relation(fields: [storyId], references: [id])
  storyId        String?
  user           User     @relation(fields: [userId], references: [id])
  userId         String
  prompt         String
  response       String   @db.Text
  model          String
  tokens         Int?
  contextSnapshot Json?
  createdAt      DateTime @default(now())
}

model ActorSuggestion {
  id         String   @id @default(uuid())
  providerId String?
  provider   String?
  name       String
  age        Int?
  gender     String?
  bio        String?
  images     Json?
  filmography Json?
  metadata   Json?
  createdAt  DateTime @default(now())
}

model CastAssignment {
  id                 String   @id @default(uuid())
  story              Story    @relation(fields: [storyId], references: [id])
  storyId            String
  character          Character @relation(fields: [characterId], references: [id])
  characterId        String
  actorSuggestion    ActorSuggestion? @relation(fields: [actorSuggestionId], references: [id])
  actorSuggestionId  String?
  assignedBy         User?    @relation(fields: [assignedById], references: [id])
  assignedById       String?
  createdAt          DateTime @default(now())
}

model VersionHistory {
  id         String   @id @default(uuid())
  entityType String
  entityId   String
  snapshot   Json
  createdBy  User?    @relation(fields: [createdById], references: [id])
  createdById String?
  createdAt  DateTime @default(now())
  note       String?
}
